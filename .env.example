# --- KryptoTrop - analiza na realnych publicznych źródłach Internetu --------------------
# Baza: brak DATABASE_URL => magazyn w pamięci (szybki start)
# DATABASE_URL=postgres://olcys:olcys-dev-only@localhost:5432/olcys

# --- Wyszukiwarka (self-hosted SearXNG) - odkomentuj po uruchomieniu: docker compose up -d searxng ---
# SEARXNG_URL=http://localhost:8888
# Sekret instancji SearXNG (docker compose) - w produkcji ustaw losową wartość
# SEARXNG_SECRET=

# --- Token GitHub (fine-grained, BEZ uprawnień - tylko dane publiczne) ---
# Bez tokena limit to 60 zapytań/h na IP - w sieci współdzielonej (hackathon, biuro) bywa wyczerpany od razu.
# Token włącza też wyszukiwanie adresu krypto w publicznym kodzie GitHuba (scenariusz "szukanie po adresie").
GITHUB_TOKEN=

# --- Reddit: posty i komentarze z profilu (false = wyłączony) ---
# Reddit zwykle odmawia zapytań anonimowych (403). Zarejestruj aplikację typu "script" na reddit.com/prefs/apps
# (tylko odczyt), wpisz jej klucze i ustaw true - wtedy KryptoTrop używa oficjalnego API OAuth zgodnie z Reddit Data API Terms.
OLCYS_REDDIT=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Tryb offline na prezentację: najpierw nagraj przebieg, potem odtwarzaj bez sieci ---
# OLCYS_RECORD_DIR=data/recordings/demo
# OLCYS_REPLAY_DIR=data/recordings/demo

# --- Kontrola ruchu wychodzącego ---
# Zapytania API (z identyfikatorami) idą tylko do zatwierdzonych hostów: lista domyślna w packages/engine/src/config.ts
# (DEFAULT_LIVE_SOURCES). Dodatkowe zatwierdzone hosty:
EGRESS_ALLOWLIST=
# Pobieranie publicznych stron odkrytych w dowodach: public (dowolny host publiczny, blokada adresów wewnętrznych - SSRF)
# lub allowlist (tylko hosty z allowlisty)
OLCYS_WEB_FETCH=public

# --- Dane blockchain (tryb live) ---
# ETH: Blockscout (open source, bez klucza; możliwa własna instancja KAS) albo Etherscan v2 po ustawieniu klucza
BLOCKSCOUT_URL=https://eth.blockscout.com
ETHERSCAN_API_KEY=
# Dodatkowe sieci EVM dla adresów 0x (wymaga ETHERSCAN_API_KEY - jeden klucz Etherscan v2 dla wszystkich sieci).
# Dostępne: polygon, arbitrum, bsc, base, optimism (część sieci wymaga płatnego planu Etherscan - błąd trafia do przebiegu).
# EVM_NETWORKS=polygon,arbitrum
# RPC Ethereum (bytecode, ENS) - może być własny węzeł KAS
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# BTC: Esplora (Blockstream / mempool / własna instancja)
ESPLORA_URL=https://blockstream.info/api
TRONGRID_URL=https://api.trongrid.io
# Solana: publiczny węzeł ma niskie limity zapytań - w KAS własny węzeł; liczba ostatnich transakcji na adres
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_MAX_TX=40
# Archiwum dziennych cen krypto (CoinGecko / Binance) - pusta wartość wyłącza
# PRICE_ARCHIVE_DIR=data/prices

# --- Pakiet dowodowy: podpis Ed25519 i znacznik czasu RFC 3161 (do TSA trafia tylko skrót SHA-256) ---
# OLCYS_TSA_URL=http://time.certum.pl
# OLCYS_SIGNING_KEY_FILE=data/keys/signing-ed25519.pem

# --- Konta analityków (opcjonalnie): npm run user:add -- <login> <analityk|przeglad|admin> ---
# Brak pliku kont = logowanie wyłączone. W produkcji ustaw stały sekret sesji.
# OLCYS_USERS_FILE=data/users.json
# OLCYS_SESSION_SECRET=

# --- AI (opcjonalnie, lokalnie) - dowolne API zgodne z OpenAI (Ollama, vLLM, LocalAI, LiteLLM) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
