# --- Tryb pracy ---------------------------------------------------------------
# demo = konektory na syntetycznym mini-internecie (apps/mock-web), live = realne źródła
OLCYS_MODE=demo
MOCK_WEB_URL=http://localhost:4100
# Baza: brak DATABASE_URL => magazyn w pamięci (szybki start)
# DATABASE_URL=postgres://olcys:olcys-dev-only@localhost:5432/olcys

# --- Kontrola ruchu wychodzącego (wymóg: brak wysyłki do niezatwierdzonych usług) ---
# Hosty poza tą listą są blokowane i logowane. W trybie live dopisz zatwierdzone źródła, np.:
# EGRESS_ALLOWLIST=api.github.com,raw.githubusercontent.com,api.gravatar.com,web.archive.org,t.me,api.etherscan.io,mempool.space,api.trongrid.io
EGRESS_ALLOWLIST=

# --- Dane blockchain ---
# fixture = dane syntetyczne (fixtures/chain), live = Etherscan v2 / Esplora / TronGrid
CHAIN_PROVIDER=fixture
ETHERSCAN_API_KEY=
ESPLORA_URL=https://mempool.space/api
# Węzeł / RPC Ethereum (ENS + bytecode); może być własny węzeł KAS
ETH_RPC_URL=

# --- AI (opcjonalnie, lokalnie) – dowolne API zgodne z OpenAI (Ollama, vLLM, LocalAI, LiteLLM) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
