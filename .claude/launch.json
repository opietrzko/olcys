{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "--env-file-if-exists=.env",
        "apps/api/src/server.ts"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@olcys/web"
      ],
      "port": 5173
    }
  ]
}