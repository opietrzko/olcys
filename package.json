{
  "name": "olcys",
  "private": true,
  "version": "0.1.0",
  "description": "KryptoTrop – od śladów w sieci do portfeli krypto (HackNation 2026, zadanie MF/KAS „OŁCyŚ”)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @olcys/api\" \"npm run dev -w @olcys/web\"",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/engine && tsc -p apps/api && tsc -p apps/web",
    "cli": "tsx --env-file-if-exists=.env scripts/cli.ts",
    "gen:address": "tsx scripts/gen-address.ts",
    "labels:update": "tsx scripts/update-labels.ts",
    "verify:package": "tsx scripts/verify-package.ts",
    "user:add": "tsx scripts/user-add.ts",
    "licenses": "npx --yes license-checker-rseidelsohn --summary --excludePrivatePackages"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "concurrently": "^9.1.2",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
